{
	"$schema": "../suite.schema.json",
	"description": "The $ namespace is reserved; unknown directives are errors",
	"spec": "../../SPEC.md#host-directives",
	"tests": [
		{
			"description": "rejects a misspelled directive",
			"documents": {
				"main.json": { "$extned": "./base.json", "a": 1 },
				"base.json": {}
			},
			"error": "unknown-directive"
		},
		{
			"description": "rejects an unknown directive deep inside a document",
			"documents": {
				"main.json": { "a": { "b": [{ "$include": "./x.json" }] } }
			},
			"error": "unknown-directive"
		},
		{
			"description": "rejects a key that is only $",
			"documents": {
				"main.json": { "$": 1 }
			},
			"error": "unknown-directive"
		},
		{
			"description": "rejects JSON Schema keywords this specification does not define",
			"documents": {
				"main.json": { "$dynamicRef": "#node" }
			},
			"error": "unknown-directive"
		},
		{
			"description": "rejects the reserved $literal",
			"documents": {
				"main.json": { "x": { "$literal": { "a": null } } }
			},
			"error": "unknown-directive"
		},
		{
			"description": "rejects an unknown directive inside a referenced value",
			"documents": {
				"main.json": { "x": { "$ref": "./a.json" } },
				"a.json": { "$oops": 1 }
			},
			"error": "unknown-directive"
		},
		{
			"description": "retains a declared host directive",
			"options": { "hostDirectives": ["$env"] },
			"documents": {
				"main.json": { "port": { "$env": "PORT" } }
			},
			"expected": { "port": { "$env": "PORT" } }
		},
		{
			"description": "resolves directives inside a host directive's value",
			"options": { "hostDirectives": ["$csv"] },
			"documents": {
				"main.json": {
					"$csv": { "$extend": "./rows.base.json", "file": "./cases.csv" }
				},
				"rows.base.json": { "delimiter": ",", "header": true }
			},
			"expected": {
				"$csv": { "delimiter": ",", "header": true, "file": "./cases.csv" }
			}
		},
		{
			"description": "merges a host directive like any other key",
			"options": { "hostDirectives": ["$csv"] },
			"documents": {
				"main.json": {
					"$extend": "./base.json",
					"$csv": { "file": "./b.csv" }
				},
				"base.json": { "$csv": { "file": "./a.csv", "header": true } }
			},
			"expected": { "$csv": { "file": "./b.csv", "header": true } }
		},
		{
			"description": "rejects an unknown directive inside a host directive's value",
			"options": { "hostDirectives": ["$csv"] },
			"documents": {
				"main.json": { "$csv": { "$oops": 1 } }
			},
			"error": "unknown-directive"
		},
		{
			"description": "rejects an undeclared directive alongside declared ones",
			"options": { "hostDirectives": ["$env"] },
			"documents": {
				"main.json": {
					"port": { "$env": "PORT" },
					"key": { "$secret": "API_KEY" }
				}
			},
			"error": "unknown-directive"
		},
		{
			"description": "ignores $ in values",
			"documents": {
				"main.json": { "price": "$5", "tags": ["$a", "$ref"] }
			},
			"expected": { "price": "$5", "tags": ["$a", "$ref"] }
		}
	]
}
